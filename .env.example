# این‌ها رو در تنظیمات Environment Variables پروژه‌ی Vercel وارد کن
# (Settings -> Environment Variables). این فایل خودش هیچ‌وقت نباید
# کامیت با مقادیر واقعی بشه.

BOT_TOKEN=            # توکن جدید بات، بعد از ابطال توکن قدیمی در BotFather
WEBHOOK_SECRET=        # یک رشته‌ی تصادفی دلخواه، مثلاً با: openssl rand -hex 20
WEB_APP_URL=           # آدرس همین پروژه روی Vercel، مثلاً https://your-app.vercel.app
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- این دو تا فقط برای اجرای محلی indexer/build_index.py لازمه، نه Vercel ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SOURCE_CHANNEL=
RELAY_CHANNEL=
